TRACE_ENABLED=false
XCODE_HOME=~/.xcode

# -- chat LLM --
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your api key
OPENAI_MODEL=deepseek-v4-flash
OPENAI_LIGHT_MODEL=deepseek-v4-flash

# -- session context / compact --
XCODE_CONTEXT_WINDOW=256000
XCODE_COMPACT_THRESHOLD=0.7
XCODE_RESERVED_OUTPUT_TOKENS=8192
XCODE_TOOL_PRUNE_CHARS=16000
XCODE_TRANSCRIPT_HARD_CAP=2000000
